# Site configuration. Never put real secrets in this file.
# Copy to .env.local for your computer; the live site's values live in
# Vercel → Settings → Environment Variables (Production).
# There are no defaults: a missing or invalid value stops `npm run dev`/`build`
# with a message naming the variable (ADR 0012). Full table with allowed values:
# docs/guides/owner-setup.md, "Required variables".
# VERCEL, VERCEL_ENV and NODE_ENV are set automatically; do not add them.

# Sample data switch: "false" = real data (staging Supabase on your computer),
# "true" = sample data, local only. Must be "false" on the live site.
# `npm run demo` sets "true" itself.
SITE_DEMO_MODE=false
# Only when SITE_DEMO_MODE=true: the ISO date-time the sample data is built
# around (e.g. 2026-09-11T12:00:00Z). The demo launcher sets it; leave it
# out otherwise. Never set on the live site.
# SITE_DEMO_DATE=

# Supabase project (staging on your computer, production on Vercel). Required
# when SITE_DEMO_MODE=false. Publishable key only (sb_publishable_…); NO secret
# or service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) used ONLY to send board invite emails; required
# when SITE_DEMO_MODE=false. On your computer keep "off" (no invite emails);
# the live site needs the real key and refuses "off". Never put a real secret
# key in this file, never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=off

# The site's address: https on the live site; http://localhost:3000 is fine locally.
SITE_URL=http://localhost:3000

# Go2Pay API key, or "off". Required when SITE_DEMO_MODE=false; ignored with
# sample data. On your computer: a "Take payments only" TEST key (g2p_test_…)
# or "off". A LIVE key (g2p_live_…, real money) is refused here; Vercel
# Production takes only a "Take payments only" live key, or "off" until launch
# (ADR 0019). A payments-only key reads orders, including real givers' names,
# emails and phones, even in test mode: keep it off computers that don't need
# it. WARNING: a full-access key ("Everything my account can do") can also
# change Go2Pay products and read the MSA's bank details; use one only on your
# own computer, delete it after use. Never put a real key in this file, never
# prefix it NEXT_PUBLIC_, never paste it in a chat or an issue.
GO2PAY_API_KEY=off

# Daily check (docs/contracts/daily-check-notifications.md). CRON_SECRET is
# required everywhere, sample data included: "off" on your computer (every call
# to /api/daily-check gets 401), or 32+ letters, digits, "_" or "-" to try the
# route locally. The live site needs the real secret and refuses "off".
CRON_SECRET=off
# The MSA Gmail and its app password "SGU MSA daily check", for the nightly
# warning email. Required when SITE_DEMO_MODE=false; ignored with sample data.
# Keep both "off" on your computer: only Vercel Production ever sends, even
# with real values here. The live site accepts both "off" too (with a build
# warning) until the MSA Gmail is set up. Never put the real app password here.
MSA_GMAIL_ADDRESS=off
GMAIL_APP_PASSWORD=off

# Live site only, required there: "true" or "false". "true" switches on Vercel
# Analytics and Speed Insights for production; never demo, preview or local.
# ENABLE_VERCEL_MEASUREMENTS=
